# Copy this file to `.env` in the SAME folder as `server.js`, then restart the server.
# Without SMTP, reset links only appear in the server console — they are NOT emailed.
#
# --- Easiest: Gmail (use an App Password, not your normal password) ---
# SMTP_PRESET=gmail
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="MedSupply Innovations <youraddress@gmail.com>"
#
# --- Outlook / Hotmail / Live ---
# SMTP_PRESET=outlook
# SMTP_USER=youraddress@outlook.com
# SMTP_PASS=your-password-or-app-password
# SMTP_FROM="MedSupply Innovations <youraddress@outlook.com>"
#
# --- Yahoo ---
# SMTP_PRESET=yahoo
# SMTP_USER=youraddress@yahoo.com
# SMTP_PASS=your-app-password
# SMTP_FROM="MedSupply Innovations <youraddress@yahoo.com>"
#
# --- Microsoft 365 / work email ---
# SMTP_PRESET=office365
# SMTP_USER=you@yourcompany.com
# SMTP_PASS=your-password
# SMTP_FROM="MedSupply Innovations <you@yourcompany.com>"
#
# --- Full control (any provider) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
#
# Optional: connection string instead of host/user/pass
# SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# Forgot-password link lifetime in hours (default 1, max 168)
# PASSWORD_RESET_EXPIRY_HOURS=1
