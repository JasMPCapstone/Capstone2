# MedSupply Portal — environment variables
# Copy to .env and adjust. Never commit .env with real secrets.

NODE_ENV=development
PORT=3000

# Required in production: strong random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# Behind nginx/Render/load balancer: forward X-Forwarded-* correctly for sessions and rate limits
TRUST_PROXY=0

# MySQL (see config/database.js)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=medsupply

# Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,doc,xls,png,jpg,jpeg

# Object storage. local = ./uploads only ; s3 = uploads copied to AWS S3 after a temp write to ./uploads/tmp
STORAGE_DRIVER=local

# When STORAGE_DRIVER=s3 — create an IAM user (or use an IAM role on AWS compute) with at least:
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject on arn:aws:s3:::YOUR_BUCKET and arn:aws:s3:::YOUR_BUCKET/*
# Block Public Access on the bucket is fine; the app serves files via the API, not public URLs.
S3_REGION=ap-southeast-2
S3_BUCKET=medsupplyproject-584612873265-ap-southeast-2-an
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave empty for AWS S3. Set only for MinIO, Cloudflare R2, DigitalOcean Spaces, etc.
S3_ENDPOINT=

# Rate limits (optional overrides)
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_FORGOT_MAX=10
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_API_MAX=300

# CORS: origin for React dev (e.g. http://localhost:5173). Leave unset for same-origin only.
# CORS_ORIGIN=http://localhost:5173

# Serve built React SPA from ./client/dist at /app (optional; run npm run build:client first)
# SERVE_SPA=0
