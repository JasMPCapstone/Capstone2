# MedSupply Portal — environment variables
# Copy to .env and adjust. Never commit .env with real secrets.

NODE_ENV=development
PORT=3000

# Required in production: strong random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# Behind nginx/Render/load balancer: forward X-Forwarded-* correctly for sessions and rate limits
TRUST_PROXY=0

# MySQL (see config/database.js)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=medsupply

# Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,doc,xls,png,jpg,jpeg

# Object storage (Phase B). local = files under ./uploads ; s3 = S3-compatible API
STORAGE_DRIVER=local

# When STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: MinIO, Cloudflare R2, DigitalOcean Spaces
S3_ENDPOINT=

# Rate limits (optional overrides)
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_FORGOT_MAX=10
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_API_MAX=300

# CORS: origin for React dev (e.g. http://localhost:5173). Leave unset for same-origin only.
# CORS_ORIGIN=http://localhost:5173

# Serve built React SPA from ./client/dist at /app (optional; run npm run build:client first)
# SERVE_SPA=0
