<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot password — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert <%= typeof alertType !== 'undefined' && alertType === 'error' ? 'error' : 'info' %>"><%= message %></div>
    <% } %>
    <div class="auth-card">
      <div class="auth-logo">
        <span class="logo-circle"><span class="logo-cross"></span></span>
        <span class="logo-label">MEDSUPPLY</span>
      </div>
      <h1 class="auth-title">Forgot password?</h1>
      <p class="auth-subtitle">Enter your email and we’ll send you a reset link.</p>
      <form method="post" action="/forgot-password" class="auth-form">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required autocomplete="email">
        <button type="submit" class="btn btn-signin">Send reset link</button>
      </form>
      <p class="form-footer"><a href="/login">Back to Sign In</a></p>
    </div>
  </div>
</body>
</html>
