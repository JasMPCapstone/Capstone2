<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Two-Factor Verification — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert <%= typeof alertType !== 'undefined' && alertType === 'error' ? 'error' : 'info' %>"><%= message %></div>
    <% } %>
    <div class="auth-card">
      <div class="auth-logo">
        <span class="logo-circle"><span class="logo-cross"></span></span>
        <span class="logo-label">MEDSUPPLY</span>
      </div>
      <h1 class="auth-title">Two-Factor Verification</h1>
      <p class="auth-subtitle">Enter the 6-digit code from your authenticator app</p>
      <form method="post" action="/login/2fa" class="auth-form">
        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
        <label for="code">Verification code</label>
        <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" maxlength="6" placeholder="000000" required autofocus class="auth-code-input">
        <button type="submit" class="btn btn-signin">Verify</button>
      </form>
      <p class="form-footer"><a href="/login">← Back to sign in</a></p>
    </div>
  </div>
</body>
</html>
