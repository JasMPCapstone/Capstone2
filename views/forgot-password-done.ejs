<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Check your email — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <div class="auth-card">
      <div class="auth-logo">
        <span class="logo-circle"><span class="logo-cross"></span></span>
        <span class="logo-label">MEDSUPPLY</span>
      </div>
      <h1 class="auth-title">Check your email</h1>
      <% if (typeof hasUser !== 'undefined' && hasUser) { %>
        <p class="auth-subtitle">If an account exists for that email, use the link below to set a new password (link expires in 1 hour):</p>
        <p class="reset-link-wrap"><a href="<%= resetLink %>" class="btn btn-signin">Reset my password</a></p>
        <p class="muted reset-link-copy">Or copy: <code class="reset-link-url"><%= resetLink %></code></p>
      <% } else { %>
        <p class="auth-subtitle">If an account exists for that email, you would receive a reset link. Check your inbox or try again.</p>
      <% } %>
      <p class="form-footer"><a href="/login">Back to Sign In</a></p>
    </div>
  </div>
</body>
</html>
