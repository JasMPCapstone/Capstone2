<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Documents — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    <h1>My Documents</h1>
    <p class="page-count"><%= typeof documents !== 'undefined' ? documents.length : 0 %> documents</p>
    <form method="get" action="/documents" class="toolbar">
      <input type="search" name="q" placeholder="Search documents..." value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>" class="toolbar-search-input">
      <select name="documentType" class="filter-select">
        <option value="">All Document Types</option>
        <option value="Facility Accreditation Certificate" <%= query && query.documentType === 'Facility Accreditation Certificate' ? 'selected' : '' %>>Facility Accreditation Certificate</option>
        <option value="Procurement Policy" <%= query && query.documentType === 'Procurement Policy' ? 'selected' : '' %>>Procurement Policy</option>
        <option value="Floor Plan" <%= query && query.documentType === 'Floor Plan' ? 'selected' : '' %>>Floor Plan</option>
        <option value="Inventory Report" <%= query && query.documentType === 'Inventory Report' ? 'selected' : '' %>>Inventory Report</option>
        <option value="Compliance Certificate" <%= query && query.documentType === 'Compliance Certificate' ? 'selected' : '' %>>Compliance Certificate</option>
        <option value="Other" <%= query && query.documentType === 'Other' ? 'selected' : '' %>>Other</option>
      </select>
      <div class="tags-filter-wrap">
        <button type="button" class="tags-filter-toggle" id="tagsFilterToggle" aria-expanded="false" aria-haspopup="true">Filter by tags</button>
        <div class="tags-filter-dropdown" id="tagsFilterDropdown" hidden>
          <% var selectedTags = (typeof query !== 'undefined' && query && Array.isArray(query.tags)) ? query.tags.map(function(t){return (t||'').toString().toLowerCase();}) : (typeof query !== 'undefined' && query && query.tags ? [(query.tags||'').toString().toLowerCase()] : []); %>
          <% (typeof availableTags !== 'undefined' ? availableTags : []).forEach(function(tag) { %>
            <label class="tags-filter-check"><input type="checkbox" name="tags" value="<%= tag %>" <%= selectedTags.indexOf(tag.toLowerCase()) >= 0 ? 'checked' : '' %>><span><%= tag %></span></label>
          <% }); %>
        </div>
      </div>
      <button type="submit" class="toolbar-search-btn">Search</button>
      <% var hasFilters = (typeof query !== 'undefined' && query && ((query.q && query.q !== '') || (query.documentType && query.documentType !== '') || (query.tags && (Array.isArray(query.tags) ? query.tags.length : 1)))); %>
      <% if (hasFilters) { %><a href="/documents" class="btn btn-clear-filters">Clear filters</a><% } %>
    </form>
    <% function sortUrl(q, s) { var p = {}; for (var k in (q||{})) { if (k === 'sort') continue; p[k] = q[k]; } p.sort = s; var parts = []; for (var k in p) { var v = p[k]; if (Array.isArray(v)) { v.forEach(function(t){ parts.push('tags='+encodeURIComponent(t)); }); } else if (v != null && v !== '') { parts.push(encodeURIComponent(k)+'='+encodeURIComponent(v)); } } return '/documents?' + parts.join('&'); } %>
    <% var currentSort = (typeof query !== 'undefined' && query && query.sort) ? query.sort : 'date'; %>
    <% if (typeof documents !== 'undefined' && documents.length > 0) { %>
      <div class="doc-list" id="docList">
        <table class="data-table doc-explorer-table">
          <thead>
            <tr>
              <th class="col-name col-sortable"><a href="<%= sortUrl(query, 'name') %>" class="th-sort-link<%= currentSort === 'name' ? ' th-sort-active' : '' %>">Name<%= currentSort === 'name' ? ' ↑' : '' %></a></th>
              <th class="col-doctype">Document Type</th>
              <th class="col-tags">Tags</th>
              <th class="col-date col-sortable"><a href="<%= sortUrl(query, 'date') %>" class="th-sort-link<%= currentSort === 'date' ? ' th-sort-active' : '' %>">Date Modified<%= currentSort === 'date' ? ' ↓' : '' %></a></th>
              <th class="col-size col-sortable"><a href="<%= sortUrl(query, 'size') %>" class="th-sort-link<%= currentSort === 'size' ? ' th-sort-active' : '' %>">Size<%= currentSort === 'size' ? ' ↓' : '' %></a></th>
              <% if (isAdmin) { %><th class="col-owner">Owner</th><% } %>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% documents.forEach(function(d) { %>
              <% var docName = (d.title || d.original_filename || '').toString(); var docType = (d.document_type || '—').toString(); var tagList = (d.tags || '').toString().trim(); var modDate = new Date(d.updated_at || d.created_at); %>
              <tr>
                <td class="col-name" title="<%= docName.replace(/"/g, '&quot;') %>"><a href="/documents/<%= d.id %>" class="doc-name-link"><%= docName %></a></td>
                <td class="col-doctype" title="<%= docType.replace(/"/g, '&quot;') %>"><%= docType %></td>
                <td class="col-tags" title="<%= tagList.replace(/"/g, '&quot;') %>"><%= tagList || '—' %></td>
                <td class="col-date" title="<%= modDate.toLocaleString() %>"><%= modDate.toLocaleDateString() %></td>
                <td class="col-size"><%= (d.file_size / 1024).toFixed(1) %> KB</td>
                <% if (isAdmin) { %><td class="col-owner" title="<%= (d.owner_name || '') + ' (' + (d.owner_email || '') + ')' %>"><%= d.owner_name %> (<%= d.owner_email %>)</td><% } %>
                <td class="col-actions">
                  <a href="/documents/<%= d.id %>" class="doc-action-btn" title="View" aria-label="View"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
                  <a href="/documents/<%= d.id %>/download" class="doc-action-btn" title="Download" aria-label="Download"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a>
                  <a href="/documents/<%= d.id %>/edit" class="doc-action-btn" title="Edit" aria-label="Edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></a>
                  <form action="/documents/<%= d.id %>/delete" method="post" class="doc-action-form" onsubmit="return confirm('Delete this document?');">
                    <button type="submit" class="doc-action-btn doc-action-delete" title="Delete" aria-label="Delete"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon empty-icon-doc"></div>
        <p class="empty-title">No documents found</p>
        <p class="empty-text">Upload your first document to get started</p>
        <a href="/documents/upload" class="btn btn-upload"><span class="icon icon-upload"></span> Upload Document</a>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function() {
      var toggle = document.getElementById('tagsFilterToggle');
      var dropdown = document.getElementById('tagsFilterDropdown');
      if (toggle && dropdown) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          var open = dropdown.hidden;
          dropdown.hidden = !open;
          toggle.setAttribute('aria-expanded', open);
        });
        document.addEventListener('click', function(e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && e.target !== toggle) {
            dropdown.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }
    })();
  </script>
</body>
</html>
