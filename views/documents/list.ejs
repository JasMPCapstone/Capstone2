<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof isSystemAdmin !== 'undefined' && isSystemAdmin) ? 'Documents' : 'Documentation' %> — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content documents-page documents-page--list documents-board-page">
    <% if (typeof isSystemAdmin === 'undefined' || !isSystemAdmin) { %>
      <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    <% } %>

    <section class="documents-board" <%= (typeof isSystemAdmin !== 'undefined' && isSystemAdmin) ? 'aria-label="Document library"' : 'aria-labelledby="documents-board-title"' %>>
      <div class="documents-board-head">
        <div class="documents-board-head-text">
          <% if (typeof isSystemAdmin === 'undefined' || !isSystemAdmin) { %>
          <h1 id="documents-board-title" class="documents-board-title">Documentation</h1>
          <% } %>
          <p class="documents-board-count"><%= typeof documents !== 'undefined' ? documents.length : 0 %> document<%= (typeof documents !== 'undefined' && documents.length !== 1) ? 's' : '' %></p>
        </div>
        <a href="/documents/upload" class="btn btn-primary documents-board-cta">Create a new document</a>
      </div>

      <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && typeof hasApprovalStatus !== 'undefined' && hasApprovalStatus) { %>
      <nav class="documents-board-tabs" aria-label="Filter by approval status">
        <a href="<%= docListUrl({ tab: 'all' }) %>" class="documents-board-tab<%= activeTab === 'all' ? ' is-active' : '' %>">All</a>
        <a href="<%= docListUrl({ tab: 'review' }) %>" class="documents-board-tab<%= activeTab === 'review' ? ' is-active' : '' %>">To review</a>
        <a href="<%= docListUrl({ tab: 'approved' }) %>" class="documents-board-tab<%= activeTab === 'approved' ? ' is-active' : '' %>">Approved</a>
        <a href="<%= docListUrl({ tab: 'rejected' }) %>" class="documents-board-tab<%= activeTab === 'rejected' ? ' is-active' : '' %>">Rejected</a>
      </nav>
      <% } %>

      <% var _hasDocFilters = (typeof query !== 'undefined' && query && ((query.q && query.q !== '') || (query.companyId && query.companyId !== '') || (query.approvalStatus && query.approvalStatus !== '') || (query.documentType && query.documentType !== '') || (query.tags && (Array.isArray(query.tags) ? query.tags.length : 1)))); %>
      <form method="get" action="/documents" class="documents-filter-bar" id="documentsFilterForm" aria-label="Search and filter documents">
        <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && typeof hasApprovalStatus !== 'undefined' && hasApprovalStatus && typeof activeTab !== 'undefined' && activeTab !== 'all') { %>
          <input type="hidden" name="tab" value="<%= activeTab %>" />
        <% } %>
        <% var _showCompanyFilter = typeof isSystemAdmin !== 'undefined' && isSystemAdmin && typeof companiesForFilter !== 'undefined' && companiesForFilter.length; %>
        <div class="documents-filter-row<%= _showCompanyFilter ? ' documents-filter-row--with-company' : ' documents-filter-row--no-company' %>">
          <div class="documents-filter-field documents-filter-field--search">
            <label class="documents-filter-label" for="docSearchQ">Search documents</label>
            <input type="search" name="q" id="docSearchQ" placeholder="Search by title or filename..." value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>" class="documents-filter-input documents-filter-input--search" autocomplete="off">
          </div>
          <div class="documents-filter-field documents-filter-field--doctype">
            <label class="documents-filter-label" for="docDocumentType">Document type</label>
            <select name="documentType" id="docDocumentType" class="documents-filter-input documents-filter-input--select" aria-label="Filter by document type" onchange="this.form.submit()">
              <option value="">All documents</option>
              <option value="Facility Accreditation Certificate" <%= query && query.documentType === 'Facility Accreditation Certificate' ? 'selected' : '' %>>Facility Accreditation Certificate</option>
              <option value="Procurement Policy" <%= query && query.documentType === 'Procurement Policy' ? 'selected' : '' %>>Procurement Policy</option>
              <option value="Floor Plan" <%= query && query.documentType === 'Floor Plan' ? 'selected' : '' %>>Floor Plan</option>
              <option value="Inventory Report" <%= query && query.documentType === 'Inventory Report' ? 'selected' : '' %>>Inventory Report</option>
              <option value="Compliance Certificate" <%= query && query.documentType === 'Compliance Certificate' ? 'selected' : '' %>>Compliance Certificate</option>
              <option value="Other" <%= query && query.documentType === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <% if (_showCompanyFilter) { %>
          <div class="documents-filter-field documents-filter-field--company">
            <label class="documents-filter-label" for="docCompanyFilter">Organization</label>
            <select name="companyId" id="docCompanyFilter" class="documents-filter-input documents-filter-input--select" aria-label="Filter by organization" onchange="this.form.submit()">
              <option value="">All organizations</option>
              <% companiesForFilter.forEach(function(co) { %>
                <option value="<%= co.id %>" <%= typeof query !== 'undefined' && query && String(query.companyId) === String(co.id) ? 'selected' : '' %>><%= co.name %></option>
              <% }); %>
            </select>
          </div>
          <% } %>
          <div class="documents-filter-field documents-filter-field--tags">
            <label class="documents-filter-label" for="tagsFilterToggle">Tags</label>
            <div class="tags-filter-wrap">
              <button type="button" class="documents-filter-input documents-filter-input--tags tags-filter-toggle" id="tagsFilterToggle" aria-expanded="false" aria-haspopup="true">Choose tags...</button>
              <div class="tags-filter-dropdown" id="tagsFilterDropdown" hidden>
                <% var selectedTags = (typeof query !== 'undefined' && query && Array.isArray(query.tags)) ? query.tags.map(function(t){return (t||'').toString().toLowerCase();}) : (typeof query !== 'undefined' && query && query.tags ? [(query.tags||'').toString().toLowerCase()] : []); %>
                <% (typeof availableTags !== 'undefined' ? availableTags : []).forEach(function(tag) { %>
                  <label class="tags-filter-check"><input type="checkbox" name="tags" value="<%= tag %>" <%= selectedTags.indexOf(tag.toLowerCase()) >= 0 ? 'checked' : '' %>><span><%= tag %></span></label>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
        <% if (_hasDocFilters) { %>
          <p class="documents-filter-clear-line"><a href="/documents" class="documents-filter-clear">Clear all filters</a></p>
        <% } %>
      </form>
    </section>

    <% var currentSort = (typeof query !== 'undefined' && query && query.sort) ? query.sort : 'date'; %>
    <% if (typeof documents !== 'undefined' && documents.length > 0) { %>
      <div class="doc-list documents-board-table-wrap" id="docList">
        <table class="data-table doc-explorer-table documents-board-table">
          <thead>
            <tr>
              <th class="col-num" scope="col">#</th>
              <th class="col-date col-sortable"><a href="<%= docListUrl({ sort: 'date' }) %>" class="th-sort-link<%= currentSort === 'date' ? ' th-sort-active' : '' %>">Date<%= currentSort === 'date' ? ' ↓' : '' %></a></th>
              <th class="col-doc col-sortable"><a href="<%= docListUrl({ sort: 'name' }) %>" class="th-sort-link<%= currentSort === 'name' ? ' th-sort-active' : '' %>">Document<%= currentSort === 'name' ? ' ↑' : '' %></a></th>
              <th class="col-doctype" scope="col">Type</th>
              <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin) { %><th class="col-company" scope="col">Organization</th><% } %>
              <% if (isAdmin) { %><th class="col-owner" scope="col">Responsible</th><% } %>
              <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && typeof hasApprovalStatus !== 'undefined' && hasApprovalStatus) { %><th class="col-approval" scope="col">Status</th><% } %>
              <th class="col-actions" scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% documents.forEach(function(d, idx) { %>
              <% var docName = (d.title || d.original_filename || '').toString(); var docType = (d.document_type || '—').toString(); var tagList = (d.tags || '').toString().trim(); var modDate = new Date(d.updated_at || d.created_at); %>
              <tr>
                <td class="col-num"><%= idx + 1 %></td>
                <td class="col-date" title="<%= modDate.toLocaleString() %>"><%= modDate.toLocaleDateString() %></td>
                <td class="col-doc" title="<%= docName.replace(/"/g, '&quot;') %>">
                  <a href="/documents/<%= d.id %>" class="doc-name-link"><%= docName %></a>
                  <% if (tagList) { %><span class="doc-inline-tags muted"><%= tagList %></span><% } %>
                </td>
                <td class="col-doctype" title="<%= docType.replace(/"/g, '&quot;') %>"><%= docType %></td>
                <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin) { %><td class="col-company" title="<%= (d.company_name || '').replace(/"/g, '&quot;') %>"><%= d.company_name || '—' %></td><% } %>
                <% if (isAdmin) { %>
                <td class="col-owner" title="<%= (d.owner_name || '') + ' (' + (d.owner_email || '') + ')' %>">
                  <span class="responsible-name"><%= d.owner_name %></span>
                  <span class="responsible-email muted"><%= d.owner_email %></span>
                </td>
                <% } %>
                <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && typeof hasApprovalStatus !== 'undefined' && hasApprovalStatus) { %>
                  <td class="col-approval"><% var st = (d.approval_status || 'PENDING').toString(); if (st === 'APPROVED') { %><span class="approval-tag approval-tag-approved">Approved</span><% } else if (st === 'REJECTED') { %><span class="approval-tag approval-tag-rejected">Rejected</span><% } else { %><span class="approval-tag approval-tag-pending">Waiting</span><% } %></td>
                <% } %>
                <td class="col-actions">
                  <div class="doc-actions-row" role="group" aria-label="Document actions">
                    <a href="/documents/<%= d.id %>" class="doc-action-btn doc-action-view" title="Details" aria-label="Details"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></a>
                    <a href="/documents/<%= d.id %>/edit" class="doc-action-btn doc-action-edit" title="Edit" aria-label="Edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></a>
                    <form action="/documents/<%= d.id %>/delete" method="post" class="doc-action-form doc-action-form-delete" onsubmit="return confirm('Delete this document?');">
                      <button type="submit" class="doc-action-btn doc-action-delete" title="Delete" aria-label="Delete"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state documents-board-empty">
        <div class="empty-icon empty-icon-doc"></div>
        <p class="empty-title">No documents found</p>
        <p class="empty-text">Try adjusting filters or upload a new file.</p>
        <a href="/documents/upload" class="btn btn-primary documents-board-cta">Create a new document</a>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function() {
      var form = document.getElementById('documentsFilterForm');
      var toggle = document.getElementById('tagsFilterToggle');
      var dropdown = document.getElementById('tagsFilterDropdown');
      var search = document.getElementById('docSearchQ');
      var debounceTimer;
      if (form && search) {
        search.addEventListener('input', function() {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() { form.submit(); }, 450);
        });
      }
      if (toggle && dropdown) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          var open = dropdown.hidden;
          dropdown.hidden = !open;
          toggle.setAttribute('aria-expanded', open);
        });
        document.addEventListener('click', function(e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && e.target !== toggle) {
            dropdown.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
        if (form) {
          dropdown.querySelectorAll('input[type="checkbox"][name="tags"]').forEach(function(cb) {
            cb.addEventListener('change', function() { form.submit(); });
          });
        }
      }
    })();
  </script>
</body>
</html>
