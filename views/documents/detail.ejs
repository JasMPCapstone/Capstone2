<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (doc.title || doc.original_filename || 'Document').toString() %> — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="doc-detail-body">
  <%- include('../partials/header') %>
  <% var _ext = (doc.file_extension || '').toString().toLowerCase().replace(/^\./, ''); %>
  <% var _viewUrl = '/documents/' + doc.id + '/view'; %>
  <% var _isPdf = _ext === 'pdf'; %>
  <% var _isImg = ['png', 'jpg', 'jpeg', 'gif', 'webp'].indexOf(_ext) >= 0; %>
  <div class="doc-view-layout">
    <div class="doc-view-preview<%= _isImg ? ' doc-view-preview-img' : '' %>">
      <% if (_isPdf) { %>
        <iframe class="doc-view-iframe" src="<%= _viewUrl %>" title="Document preview"></iframe>
      <% } else if (_isImg) { %>
        <img src="<%= _viewUrl %>" alt="" class="doc-view-img" />
      <% } else { %>
        <div class="doc-view-no-preview">
          <div class="doc-view-no-preview-icon" aria-hidden="true"><%= _ext ? _ext.slice(0, 4).toUpperCase() : 'FILE' %></div>
          <p>No inline preview for this file type.</p>
          <a href="/documents/<%= doc.id %>/download" class="doc-view-action-btn btn-primary" style="display: inline-block; width: auto; padding-left: 1.25rem; padding-right: 1.25rem;">Download to open</a>
        </div>
      <% } %>
    </div>
    <aside class="doc-view-sidebar">
      <div class="doc-view-sidebar-header">
        <a href="/documents" class="doc-view-back">← Back to documentation</a>
        <h1 class="doc-view-sidebar-title"><%= (doc.title || doc.original_filename || 'Untitled').toString() %></h1>
      </div>
      <div class="doc-view-meta">
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">File</span>
          <span class="doc-view-meta-value"><%= doc.original_filename %></span>
        </div>
        <% if (doc.document_type) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Type</span>
          <span class="doc-view-meta-value"><%= doc.document_type %></span>
        </div>
        <% } %>
        <% if (doc.tags && String(doc.tags).trim()) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Tags</span>
          <span class="doc-view-meta-value"><%= doc.tags %></span>
        </div>
        <% } %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Size</span>
          <span class="doc-view-meta-value"><%= (Number(doc.file_size) / 1024).toFixed(1) %> KB</span>
        </div>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Updated</span>
          <span class="doc-view-meta-value"><%= new Date(doc.updated_at || doc.created_at).toLocaleString() %></span>
        </div>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Uploaded by</span>
          <span class="doc-view-meta-value"><%= doc.owner_name %> <span class="muted"><%= doc.owner_email %></span></span>
        </div>
        <% } %>
        <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && doc.company_name) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Organization</span>
          <span class="doc-view-meta-value"><%= doc.company_name %></span>
        </div>
        <% } %>
        <% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin && doc.approval_status) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Approval</span>
          <span class="doc-view-meta-value">
            <% var st = (doc.approval_status || '').toString(); if (st === 'APPROVED') { %><span class="approval-tag approval-tag-approved">Approved</span><% } else if (st === 'REJECTED') { %><span class="approval-tag approval-tag-rejected">Rejected</span><% } else { %><span class="approval-tag approval-tag-pending">Waiting</span><% } %>
          </span>
        </div>
        <% } %>
        <% if (doc.description && String(doc.description).trim()) { %>
        <div class="doc-view-meta-row">
          <span class="doc-view-meta-label">Description</span>
          <span class="doc-view-meta-value"><%= doc.description %></span>
        </div>
        <% } %>
      </div>
      <div class="doc-view-actions">
        <a href="/documents/<%= doc.id %>/download" class="doc-view-action-btn btn-primary">Download</a>
        <a href="/documents/<%= doc.id %>/edit" class="doc-view-action-btn">Edit details</a>
        <form action="/documents/<%= doc.id %>/delete" method="post" class="doc-view-action-form" onsubmit="return confirm('Delete this document permanently?');">
          <button type="submit" class="doc-view-action-btn btn-danger">Delete</button>
        </form>
      </div>
    </aside>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
