<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Documents — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    <h1>Upload Documents</h1>
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert error"><%= message %></div>
    <% } %>
    <div class="upload-card">
      <form method="post" action="/documents/upload" enctype="multipart/form-data" id="uploadForm">
        <div class="form-section">
          <h3 class="form-section-title">Document Type</h3>
          <select name="documentType" id="documentType" class="input-select">
            <option value="">Choose your document type</option>
            <option value="Facility Accreditation Certificate">Facility Accreditation Certificate</option>
            <option value="Procurement Policy">Procurement Policy</option>
            <option value="Floor Plan">Floor Plan</option>
            <option value="Inventory Report">Inventory Report</option>
            <option value="Compliance Certificate">Compliance Certificate</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-section">
          <h3 class="form-section-title">Document Details</h3>
          <label for="title">Document Title</label>
          <input type="text" id="title" name="title" class="input-text" placeholder="Enter document title">
          <label for="description">Description (optional)</label>
          <textarea id="description" name="description" rows="3" class="input-textarea" placeholder="Enter document description"></textarea>
        </div>
        <div class="form-section">
          <h3 class="form-section-title">Tags</h3>
          <div class="tag-pills" id="tagPills">
            <button type="button" class="tag-pill" data-tag="compliance">compliance</button>
            <button type="button" class="tag-pill" data-tag="inventory">inventory</button>
            <button type="button" class="tag-pill" data-tag="accreditation">accreditation</button>
            <button type="button" class="tag-pill" data-tag="safety">safety</button>
            <button type="button" class="tag-pill" data-tag="quality">quality</button>
            <button type="button" class="tag-pill" data-tag="procurement">procurement</button>
            <button type="button" class="tag-pill" data-tag="regulatory">regulatory</button>
            <button type="button" class="tag-pill" data-tag="financial">financial</button>
            <button type="button" class="tag-pill" data-tag="other">other</button>
          </div>
          <input type="hidden" name="tags" id="tagsInput" value="">
        </div>
        <div class="form-section">
          <div class="drop-zone" id="dropZone">
            <input type="file" id="document" name="document" accept=".pdf,.docx,.doc,.xlsx,.xls,.png,.jpg,.jpeg" required class="drop-zone-input">
            <div class="drop-zone-content" id="dropZoneContent">
              <span class="drop-zone-icon">↑</span>
              <p>Drag and drop files here</p>
              <p class="drop-zone-or">or</p>
              <button type="button" class="btn-browse" id="browseBtn">Browse Files</button>
              <p class="drop-zone-formats">PDF, Word (DOC/DOCX), Excel (XLS/XLSX), PNG, JPG (max 10MB)</p>
            </div>
            <div class="drop-zone-preview" id="dropZonePreview"></div>
          </div>
        </div>
        <button type="submit" class="btn btn-upload-submit" id="submitBtn">Upload <span id="fileCount">0</span> Files</button>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function() {
      var tagPills = document.getElementById('tagPills');
      var tagsInput = document.getElementById('tagsInput');
      var selectedTags = [];
      if (tagPills) {
        tagPills.querySelectorAll('.tag-pill').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var tag = this.getAttribute('data-tag');
            var i = selectedTags.indexOf(tag);
            if (i === -1) { selectedTags.push(tag); this.classList.add('selected'); }
            else { selectedTags.splice(i, 1); this.classList.remove('selected'); }
            tagsInput.value = selectedTags.join(', ');
          });
        });
      }
      var dropZone = document.getElementById('dropZone');
      var dropZoneContent = document.getElementById('dropZoneContent');
      var dropZonePreview = document.getElementById('dropZonePreview');
      var fileInput = document.getElementById('document');
      var browseBtn = document.getElementById('browseBtn');
      var fileCountEl = document.getElementById('fileCount');
      var lastPreviewUrl = null;
      if (browseBtn && fileInput) browseBtn.addEventListener('click', function() { fileInput.click(); });
      function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
      }
      function ext(name) {
        var i = name.lastIndexOf('.');
        return i >= 0 ? name.slice(i + 1).toLowerCase() : '';
      }
      function isImage(extName) {
        return extName === 'png' || extName === 'jpg' || extName === 'jpeg';
      }
      function clearFile() {
        if (lastPreviewUrl) { URL.revokeObjectURL(lastPreviewUrl); lastPreviewUrl = null; }
        fileInput.value = '';
        dropZone.classList.remove('drop-zone-has-file');
        dropZonePreview.innerHTML = '';
        dropZonePreview.style.display = 'none';
        dropZoneContent.style.display = 'block';
        fileCountEl.textContent = '0';
      }
      function updatePreview() {
        if (!dropZonePreview || !dropZoneContent) return;
        if (lastPreviewUrl) { URL.revokeObjectURL(lastPreviewUrl); lastPreviewUrl = null; }
        var file = fileInput.files[0];
        if (!file) {
          clearFile();
          return;
        }
        dropZone.classList.add('drop-zone-has-file');
        dropZoneContent.style.display = 'none';
        dropZonePreview.style.display = 'block';
        var extName = ext(file.name);
        var imgPreview = isImage(extName);
        var html = '<div class="dz-preview-inner">';
        if (imgPreview) {
          lastPreviewUrl = URL.createObjectURL(file);
          html += '<img src="' + lastPreviewUrl + '" alt="" class="dz-preview-img">';
        } else {
          html += '<span class="dz-preview-icon">' + extName.toUpperCase() + '</span>';
        }
        html += '<div class="dz-preview-info"><span class="dz-preview-name">' + file.name + '</span><span class="dz-preview-size">' + formatSize(file.size) + '</span></div>';
        html += '<button type="button" class="dz-preview-remove" title="Remove file">×</button></div>';
        dropZonePreview.innerHTML = html;
        fileCountEl.textContent = '1';
        dropZonePreview.querySelector('.dz-preview-remove').addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          clearFile();
        });
      }
      if (fileInput) {
        fileInput.addEventListener('change', updatePreview);
      }
      if (dropZone && fileInput) {
        dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('dragover'); });
        dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('dragover'); });
        dropZone.addEventListener('drop', function(e) {
          e.preventDefault();
          dropZone.classList.remove('dragover');
          if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            updatePreview();
          }
        });
      }
    })();
  </script>
</body>
</html>
