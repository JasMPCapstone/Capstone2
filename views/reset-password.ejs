<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Set new password — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert <%= typeof alertType !== 'undefined' && alertType === 'error' ? 'error' : 'info' %>"><%= message %></div>
    <% } %>
    <div class="auth-card">
      <div class="auth-logo">
        <span class="logo-circle"><span class="logo-cross"></span></span>
        <span class="logo-label">MEDSUPPLY</span>
      </div>
      <h1 class="auth-title">Set new password</h1>
      <p class="auth-subtitle">Enter your new password (min 6 characters).</p>
      <form method="post" action="/reset-password/<%= token %>" class="auth-form">
        <label for="password">New password</label>
        <input type="password" id="password" name="password" placeholder="Enter new password" required minlength="6" autocomplete="new-password">
        <button type="submit" class="btn btn-signin">Reset password</button>
      </form>
      <p class="form-footer"><a href="/login">Back to Sign In</a></p>
    </div>
  </div>
</body>
</html>
