<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Two-Factor Authentication — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
    <h1>Two-Factor Authentication</h1>
    <% if (typeof require2FA !== 'undefined' && require2FA) { %>
      <div class="alert info">Your organization requires two-factor authentication. Finish setup below to access the portal.</div>
    <% } %>
    <% if (typeof twoFactorEnabled !== 'undefined' && twoFactorEnabled) { %>
      <div class="settings-card">
        <div class="alert info">Two-factor authentication is enabled. Your account is protected.</div>
        <p>When you sign in, you'll need your password and a 6-digit code from your authenticator app.</p>
        <form method="post" action="/settings/2fa/disable" class="settings-form" onsubmit="return confirm('Disable two-factor authentication? Your account will be less secure.');">
          <label for="password">Enter your password to disable 2FA</label>
          <input type="password" id="password" name="password" required placeholder="Your password" class="input-text">
          <button type="submit" class="btn btn-danger">Disable 2FA</button>
        </form>
      </div>
    <% } else if (typeof qrDataURL !== 'undefined' && qrDataURL) { %>
      <div class="settings-card">
        <h2>Scan QR code</h2>
        <p>Use an authenticator app (Google Authenticator, Authy, Microsoft Authenticator, etc.):</p>
        <ol class="twofa-steps">
          <li>Open your authenticator app on your phone</li>
          <li>Tap "Add account" or the + button</li>
          <li>Scan the QR code below <strong>or</strong> choose "Enter key manually" and use the secret key</li>
        </ol>
        <div class="twofa-qr-wrap">
          <img src="<%= qrDataURL %>" alt="QR code for authenticator - scan with your app" class="twofa-qr" width="256" height="256">
        </div>
        <% if (manualSecret) { %>
          <div class="twofa-manual">
            <p><strong>Can't scan?</strong> Enter this key manually in your app (choose "Enter a setup key" or similar):</p>
            <p class="twofa-secret-wrap">
              <code class="twofa-secret" id="twofaSecret"><%= manualSecret %></code>
              <button type="button" class="btn btn-copy-secret" id="copySecretBtn" title="Copy key">Copy</button>
            </p>
            <p class="twofa-manual-hint">Use "MedSupply" or your email as the account name when adding manually.</p>
          </div>
        <% } %>
        <form method="post" action="/settings/2fa/verify" class="settings-form">
          <label for="code">Enter the 6-digit code from your app to verify</label>
          <input type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="000000" required class="input-text auth-code-input">
          <div class="settings-form-actions">
            <button type="submit" class="btn btn-primary">Enable 2FA</button>
            <button type="submit" formaction="/settings/2fa/cancel" formmethod="post" class="btn btn-secondary">Cancel</button>
          </div>
        </form>
      </div>
    <% } else { %>
      <div class="settings-card">
        <% if (typeof query !== 'undefined' && query) { %>
          <% if (query.enabled === '1') { %><div class="alert info">Two-factor authentication has been enabled.</div><% } %>
          <% if (query.disabled === '1') { %><div class="alert info">Two-factor authentication has been disabled.</div><% } %>
          <% if (query.error === 'invalid') { %><div class="alert error">Invalid code. Please try again.</div><% } %>
          <% if (query.error === 'password') { %><div class="alert error">Please enter your password.</div><% } %>
          <% if (query.error === 'wrongpassword') { %><div class="alert error">Incorrect password.</div><% } %>
        <% } %>
        <p>Two-factor authentication adds an extra layer of security. When enabled, you'll need your password and a code from your phone to sign in.</p>
        <form method="post" action="/settings/2fa/enable">
          <button type="submit" class="btn btn-primary">Enable Two-Factor Authentication</button>
        </form>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function() {
      var copyBtn = document.getElementById('copySecretBtn');
      var secretEl = document.getElementById('twofaSecret');
      if (copyBtn && secretEl) {
        copyBtn.addEventListener('click', function() {
          var text = secretEl.textContent.replace(/\s/g, '');
          navigator.clipboard.writeText(text).then(function() {
            copyBtn.textContent = 'Copied!';
            setTimeout(function() { copyBtn.textContent = 'Copy'; }, 2000);
          });
        });
      }
    })();
  </script>
</body>
</html>
