<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <main class="container main-content">
    <% if (typeof profileUpdated !== 'undefined' && profileUpdated) { %>
      <div class="alert info">Profile updated.</div>
    <% } %>
    <% if (typeof needMigration !== 'undefined' && needMigration) { %>
      <div class="alert error">Profile could not be saved. Run the database migration: db/migrate-profile-fields.sql</div>
    <% } %>
    <div class="dashboard-grid">
      <section class="dashboard-card welcome-card" id="profileCard">
        <div class="profile-card-header">
          <div class="avatar"><%= (profile.given_name || profile.full_name || user.fullName || user.email || 'U').toString().trim().split(/\s+/).map(function(s){ return s[0]; }).join('').slice(0,2).toUpperCase() %></div>
          <button type="button" class="btn-icon-pencil" id="editProfileBtn" title="Edit profile" aria-label="Edit profile">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
        </div>
        <h2 class="welcome-title">Welcome, <%= (profile.full_name || user.fullName || user.email || 'User').toString().trim() %>!</h2>
        <p class="welcome-email"><span class="icon icon-envelope"></span> <%= user.email %></p>
        <% if (profile.company) { %><p class="welcome-company"><span class="icon icon-building"></span> <%= profile.company %></p><% } %>
      </section>
      <section class="dashboard-card total-card">
        <span class="stat-value"><%= totalDocs %></span>
        <span class="stat-label">Total Documents</span>
        <a href="/documents/upload" class="btn btn-upload"><span class="icon icon-upload"></span> Upload New Document</a>
        <a href="/documents" class="card-link">View All Documents</a>
      </section>
    </div>
    <section class="recent-section">
      <div class="recent-header">
        <h2>Recent Documents</h2>
        <a href="/documents" class="link-see-all">See all</a>
      </div>
      <% if (typeof recentDocs !== 'undefined' && recentDocs.length > 0) { %>
        <ul class="recent-list">
          <% recentDocs.forEach(function(d) { %>
            <li><a href="/documents/<%= d.id %>" class="recent-doc-link" data-doc-id="<%= d.id %>" data-ext="<%= (d.file_extension || '').toLowerCase() %>" data-filename="<%= (d.title || d.original_filename || '').toString().replace(/"/g, '&quot;') %>" data-file-size="<%= d.file_size %>" data-created-at="<%= new Date(d.created_at).toLocaleString() %>" data-description="<%= (d.description || '').toString().replace(/"/g, '&quot;').replace(/\s+/g, ' ').trim() %>"><%= d.title || d.original_filename %></a> <span class="muted">— <%= d.file_extension.toUpperCase() %>, <%= new Date(d.created_at).toLocaleDateString() %></span></li>
          <% }); %>
        </ul>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon"></div>
          <p class="empty-title">No documents yet</p>
          <p class="empty-text">Get started by uploading your first document</p>
          <a href="/documents/upload" class="btn btn-upload"><span class="icon icon-upload"></span> Upload Document</a>
        </div>
      <% } %>
    </section>
  </main>

  <div class="profile-modal-overlay" id="profileModal" aria-hidden="true">
    <div class="profile-modal-card" role="dialog" aria-labelledby="profileModalTitle">
      <div class="profile-modal-header">
        <h2 id="profileModalTitle">Edit profile</h2>
        <button type="button" class="profile-modal-close" id="closeProfileModal" aria-label="Close">&times;</button>
      </div>
      <form method="post" action="/profile" class="profile-edit-form">
        <div class="profile-modal-section">
          <label>Given name</label>
          <span class="input-wrap-readonly" title="This field cannot be edited">
            <input type="text" class="input-readonly" value="<%= (profile.given_name || profile.full_name || user.fullName || '—').toString().trim().replace(/"/g, '&quot;') %>" readonly tabindex="-1">
            <span class="input-readonly-icon" aria-hidden="true"></span>
          </span>
          <label>Last name</label>
          <span class="input-wrap-readonly" title="This field cannot be edited">
            <input type="text" class="input-readonly" value="<%= (profile.last_name || '—').toString().trim().replace(/"/g, '&quot;') %>" readonly tabindex="-1">
            <span class="input-readonly-icon" aria-hidden="true"></span>
          </span>
          <label>Email</label>
          <span class="input-wrap-readonly" title="This field cannot be edited">
            <input type="text" class="input-readonly" value="<%= (user.email || '').toString().replace(/"/g, '&quot;') %>" readonly tabindex="-1">
            <span class="input-readonly-icon" aria-hidden="true"></span>
          </span>
        </div>
        <div class="profile-modal-section">
          <label>Preferred name</label>
          <input type="text" name="preferredName" value="<%= (profile.preferred_name || '').toString().replace(/"/g, '&quot;') %>" placeholder="What we should call you">
          <label>Address</label>
          <input type="text" name="addressSuburb" value="<%= (profile.address_suburb || '').toString().replace(/"/g, '&quot;') %>" placeholder="Suburb">
          <input type="text" name="addressCity" value="<%= (profile.address_city || '').toString().replace(/"/g, '&quot;') %>" placeholder="City">
          <input type="text" name="addressState" value="<%= (profile.address_state || '').toString().replace(/"/g, '&quot;') %>" placeholder="State">
          <label>Emergency contact</label>
          <input type="text" name="emergencyContactName" value="<%= (profile.emergency_contact_name || '').toString().replace(/"/g, '&quot;') %>" placeholder="Name">
          <input type="text" name="emergencyContactPhone" value="<%= (profile.emergency_contact_phone || '').toString().replace(/"/g, '&quot;') %>" placeholder="Phone">
          <label>Company</label>
          <select name="company" class="input-select">
            <option value="">—</option>
            <option value="Personal account" <%= profile.company === 'Personal account' ? 'selected' : '' %>>Personal account</option>
            <option value="MedSupply Innovations" <%= profile.company === 'MedSupply Innovations' ? 'selected' : '' %>>MedSupply Innovations</option>
          </select>
        </div>
        <div class="profile-edit-actions">
          <button type="submit" class="btn btn-primary">Save</button>
          <button type="button" class="btn btn-cancel-profile" id="cancelProfileBtn">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <div class="doc-preview-overlay" id="docPreviewModal" aria-hidden="true">
    <div class="doc-preview-card doc-preview-split">
      <div class="doc-view-preview">
        <div class="doc-preview-body" style="flex:1;display:flex;align-items:stretch;justify-content:stretch;">
          <iframe id="docPreviewIframe" class="doc-view-iframe" title="Document preview"></iframe>
          <img id="docPreviewImg" class="doc-view-img" alt="" style="display:none;">
          <div id="docPreviewDocx" class="doc-view-docx-container" style="display:none;"><div id="docPreviewDocxBody" class="docx-wrapper"></div></div>
        </div>
      </div>
      <aside class="doc-view-sidebar">
        <div class="doc-view-sidebar-header">
          <h2 id="docPreviewTitle" class="doc-view-sidebar-title">Document</h2>
          <button type="button" class="profile-modal-close" id="closeDocPreview" aria-label="Close">&times;</button>
        </div>
        <div class="doc-view-meta" id="docPreviewMeta">
          <div class="doc-view-meta-row">
            <span class="doc-view-meta-label">File</span>
            <span class="doc-view-meta-value" id="docPreviewFilename">—</span>
          </div>
          <div class="doc-view-meta-row">
            <span class="doc-view-meta-label">Type</span>
            <span class="doc-view-meta-value" id="docPreviewType">—</span>
          </div>
          <div class="doc-view-meta-row">
            <span class="doc-view-meta-label">Size</span>
            <span class="doc-view-meta-value" id="docPreviewSize">—</span>
          </div>
          <div class="doc-view-meta-row">
            <span class="doc-view-meta-label">Uploaded</span>
            <span class="doc-view-meta-value" id="docPreviewDate">—</span>
          </div>
          <div class="doc-view-meta-row">
            <span class="doc-view-meta-label">Description</span>
            <span class="doc-view-meta-value" id="docPreviewDescription">—</span>
          </div>
        </div>
        <div class="doc-view-actions">
          <a id="docPreviewDownloadBtn" href="#" class="btn btn-primary doc-view-action-btn">Download</a>
          <a id="docPreviewEditBtn" href="#" class="btn doc-view-action-btn">Edit</a>
          <form id="docPreviewDeleteForm" action="#" method="post" class="doc-view-action-form" onsubmit="return confirm('Delete this document?');">
            <button type="submit" class="btn btn-danger doc-view-action-btn">Delete</button>
          </form>
        </div>
      </aside>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"></script>
  <script src="https://unpkg.com/docx-preview@0.3.7/dist/docx-preview.min.js"></script>
  <script>
    (function() {
      var editBtn = document.getElementById('editProfileBtn');
      var modal = document.getElementById('profileModal');
      var closeBtn = document.getElementById('closeProfileModal');
      var cancelBtn = document.getElementById('cancelProfileBtn');
      function openModal() {
        if (modal) {
          modal.classList.add('profile-modal-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      }
      function closeModal() {
        if (modal) {
          modal.classList.remove('profile-modal-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }
      if (editBtn) editBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', function(e) {
          if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && modal.classList.contains('profile-modal-open')) closeModal();
        });
      }

      var docPreviewModal = document.getElementById('docPreviewModal');
      var docPreviewIframe = document.getElementById('docPreviewIframe');
      var docPreviewTitle = document.getElementById('docPreviewTitle');
      var docPreviewFilename = document.getElementById('docPreviewFilename');
      var docPreviewType = document.getElementById('docPreviewType');
      var docPreviewSize = document.getElementById('docPreviewSize');
      var docPreviewDate = document.getElementById('docPreviewDate');
      var docPreviewDescription = document.getElementById('docPreviewDescription');
      var docPreviewDownloadBtn = document.getElementById('docPreviewDownloadBtn');
      var docPreviewEditBtn = document.getElementById('docPreviewEditBtn');
      var docPreviewDeleteForm = document.getElementById('docPreviewDeleteForm');
      var closeDocPreview = document.getElementById('closeDocPreview');
      var docPreviewImg = document.getElementById('docPreviewImg');
      var docPreviewDocx = document.getElementById('docPreviewDocx');
      var docPreviewDocxBody = document.getElementById('docPreviewDocxBody');
      var imageExts = ['png', 'jpg', 'jpeg', 'gif', 'webp'];
      var docxExts = ['docx', 'doc'];
      document.querySelectorAll('.recent-doc-link').forEach(function(a) {
        a.addEventListener('click', function(e) {
          e.preventDefault();
          var id = this.getAttribute('data-doc-id');
          var ext = (this.getAttribute('data-ext') || '').toLowerCase();
          var filename = this.getAttribute('data-filename') || 'Document';
          var fileSize = this.getAttribute('data-file-size');
          var createdAt = this.getAttribute('data-created-at') || '—';
          var description = this.getAttribute('data-description') || '';
          if (!id) return;
          docPreviewTitle.textContent = filename;
          docPreviewFilename.textContent = filename;
          docPreviewType.textContent = ext ? ext.toUpperCase() : '—';
          docPreviewSize.textContent = fileSize ? (parseInt(fileSize, 10) / 1024).toFixed(1) + ' KB' : '—';
          docPreviewDate.textContent = createdAt;
          docPreviewDescription.textContent = description || '—';
          docPreviewDownloadBtn.href = '/documents/' + id + '/download';
          docPreviewEditBtn.href = '/documents/' + id + '/edit';
          docPreviewDeleteForm.action = '/documents/' + id + '/delete';
          document.querySelector('.doc-preview-body').classList.remove('doc-preview-body-img');
          docPreviewIframe.style.display = 'none';
          docPreviewIframe.src = '';
          docPreviewImg.style.display = 'none';
          docPreviewImg.src = '';
          docPreviewDocx.style.display = 'none';
          docPreviewDocxBody.innerHTML = '';
          var isImage = imageExts.indexOf(ext) !== -1;
          var isPdf = ext === 'pdf';
          var isDocx = docxExts.indexOf(ext) !== -1;
          if (isImage) {
            docPreviewImg.src = '/documents/' + id + '/view';
            docPreviewImg.alt = filename;
            docPreviewImg.style.display = 'block';
            document.querySelector('.doc-preview-body').classList.add('doc-preview-body-img');
          } else if (isPdf) {
            document.querySelector('.doc-preview-body').classList.remove('doc-preview-body-img');
            docPreviewIframe.src = '/documents/' + id + '/view';
            docPreviewIframe.style.display = 'block';
          } else if (isDocx) {
            document.querySelector('.doc-preview-body').classList.remove('doc-preview-body-img');
            docPreviewDocx.style.display = 'flex';
            fetch('/documents/' + id + '/view', { credentials: 'same-origin' })
              .then(function(r) { return r.blob(); })
              .then(function(blob) { return docx.renderAsync(blob, docPreviewDocxBody, null, { className: 'docx', inWrapper: true }); })
              .catch(function() { docPreviewDocxBody.innerHTML = '<p style="color:#666">Preview failed. Use Download button.</p>'; });
          }
          docPreviewModal.classList.add('profile-modal-open');
          docPreviewModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });
      function closeDocPreviewModal() {
        docPreviewModal.classList.remove('profile-modal-open');
        docPreviewModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        docPreviewIframe.src = 'about:blank';
      }
      if (closeDocPreview) closeDocPreview.addEventListener('click', closeDocPreviewModal);
      docPreviewModal.addEventListener('click', function(e) {
        if (e.target === docPreviewModal) closeDocPreviewModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && docPreviewModal.classList.contains('profile-modal-open')) closeDocPreviewModal();
      });
    })();
  </script>
</body>
</html>
