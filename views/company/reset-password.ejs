<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset password — <%= targetUser.email %> — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <a href="/company/team" class="back-link">← Back to team</a>
    <h1>Set temporary password</h1>
    <p><%= targetUser.full_name %> (<%= targetUser.email %>)</p>
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert error"><%= message %></div>
    <% } %>
    <div class="settings-card" style="max-width: 420px;">
      <form method="post" action="/company/team/<%= targetUser.id %>/reset-password" class="settings-form">
        <label for="newPassword">New temporary password</label>
        <input type="text" id="newPassword" name="newPassword" required minlength="6" class="input-text" autocomplete="new-password">
        <button type="submit" class="btn btn-primary">Save</button>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
