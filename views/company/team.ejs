<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="team-page-body">
  <%- include('../partials/header') %>
  <% 
    function teamInitials(fullName) {
      var n = (fullName || '').trim();
      if (!n) return '?';
      var parts = n.split(/\s+/).filter(function (p) { return p.length; });
      if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      return n.substring(0, 2).toUpperCase();
    }
    var managers = members.filter(function (m) { return m.role === 'CLIENT_ADMIN'; });
    var staffList = members.filter(function (m) { return m.role === 'CLIENT'; });
  %>
  <main class="container main-content team-page">
    <header class="team-page-header">
      <div class="team-page-header-text">
        <h1 class="team-page-title">My Team</h1>
        <p class="team-page-org"><%= companyName %></p>
      </div>
    </header>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert info team-page-alert"><%= message %></div>
    <% } %>

    <details class="team-add-details">
      <summary class="team-add-summary">Add a staff member</summary>
      <div class="team-add-card settings-card">
        <p class="team-add-lede muted">Create an account with a temporary password. They will set a new password, complete their profile, and enable two-factor authentication on first sign-in.</p>
        <form method="post" action="/company/team" class="settings-form team-add-form">
          <label for="fullName">Full name</label>
          <input type="text" id="fullName" name="fullName" required class="input-text" autocomplete="name">
          <label for="email">Work email</label>
          <input type="email" id="email" name="email" required class="input-text" autocomplete="off">
          <label for="tempPassword">Temporary password</label>
          <input type="text" id="tempPassword" name="tempPassword" required minlength="6" class="input-text" autocomplete="new-password" placeholder="Share this securely with the new user">
          <button type="submit" class="btn btn-primary">Create account</button>
        </form>
      </div>
    </details>

    <section class="team-section" aria-labelledby="team-managers-heading">
      <h2 id="team-managers-heading" class="team-section-heading">Managers</h2>
      <div class="team-grid">
        <% managers.forEach(function(u) { %>
        <article class="team-member-card">
          <span class="team-card-status team-card-status--<%= !u.is_active ? 'inactive' : (u.password_must_change ? 'pending' : 'active') %>">
            <% if (!u.is_active) { %>Inactive<% } else if (u.password_must_change) { %>Pending setup<% } else { %>Active<% } %>
          </span>
          <div class="team-card-avatar" aria-hidden="true"><%= teamInitials(u.full_name) %></div>
          <h3 class="team-card-name"><%= u.full_name %><% if (u.id === user.userId) { %> <span class="team-card-you">(you)</span><% } %></h3>
          <p class="team-card-email"><%= u.email %></p>
          <p class="team-card-role">Manager</p>
          <div class="team-card-footer team-card-footer--solo">
            <span class="team-card-footer-note muted">Full access to this organization</span>
          </div>
        </article>
        <% }); %>
      </div>
    </section>

    <section class="team-section" aria-labelledby="team-staff-heading">
      <h2 id="team-staff-heading" class="team-section-heading">Staff</h2>
      <% if (!staffList.length) { %>
        <p class="team-empty muted">No staff accounts yet. Use <strong>Add a staff member</strong> above to invite someone.</p>
      <% } else { %>
      <div class="team-grid">
        <% staffList.forEach(function(u) { %>
        <article class="team-member-card">
          <span class="team-card-status team-card-status--<%= !u.is_active ? 'inactive' : (u.password_must_change ? 'pending' : 'active') %>">
            <% if (!u.is_active) { %>Inactive<% } else if (u.password_must_change) { %>Pending setup<% } else { %>Active<% } %>
          </span>
          <div class="team-card-avatar team-card-avatar--staff" aria-hidden="true"><%= teamInitials(u.full_name) %></div>
          <h3 class="team-card-name"><%= u.full_name %></h3>
          <p class="team-card-email"><%= u.email %></p>
          <p class="team-card-role">Staff</p>
          <div class="team-card-footer">
            <% if (!u.is_active) { %>
            <span class="team-card-action-placeholder" aria-hidden="true"></span>
            <form method="post" action="/company/team/<%= u.id %>/reactivate" class="team-card-action-form">
              <button type="submit" class="team-card-action team-card-action--primary">
                <svg class="team-card-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                Reactivate
              </button>
            </form>
            <% } else if (u.id !== user.userId) { %>
            <a href="/company/team/<%= u.id %>/reset-password" class="team-card-action">
              <svg class="team-card-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Reset access
            </a>
            <form method="post" action="/company/team/<%= u.id %>/deactivate" class="team-card-action-form" onsubmit="return confirm('Deactivate this team member? They will not be able to sign in until reactivated.');">
              <button type="submit" class="team-card-action team-card-action--danger">
                <svg class="team-card-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Deactivate
              </button>
            </form>
            <% } else { %>
            <a href="/company/team/<%= u.id %>/reset-password" class="team-card-action team-card-action--full">
              <svg class="team-card-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Reset access
            </a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
