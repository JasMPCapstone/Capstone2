<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset password — Admin — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <h1>Reset password</h1>
    <p>User: <strong><%= targetUser.full_name %></strong> (<%= targetUser.email %>)</p>
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert error"><%= message %></div>
    <% } %>
    <div class="form-card">
      <form method="post" action="/admin/users/<%= targetUser.id %>/reset-password">
        <label for="newPassword">New password (min 6 characters)</label>
        <input type="password" id="newPassword" name="newPassword" required minlength="6" autocomplete="new-password">
        <button type="submit" class="btn btn-primary">Reset password</button>
      </form>
    </div>
    <p><a href="/admin/users">Back to users</a></p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
