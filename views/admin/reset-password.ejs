<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset password — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert error"><%= message %></div>
    <% } %>

    <section class="settings-card admin-form-card">
      <form method="post" action="/admin/users/<%= targetUser.id %>/reset-password" class="settings-form">
        <label for="newPassword">New password (min 6 characters)</label>
        <input type="password" id="newPassword" name="newPassword" required minlength="6" autocomplete="new-password" class="input-text">
        <button type="submit" class="btn btn-primary">Update password</button>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
