<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit log — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <section class="settings-card admin-filter-card">
      <h2 class="admin-card-title">Filters</h2>
      <form method="get" action="/admin/audit" class="filters admin-audit-filters">
        <input type="text" name="action" placeholder="Action code" value="<%= query && query.action ? query.action : '' %>" class="input-text">
        <input type="number" name="userId" placeholder="User ID" value="<%= query && query.userId ? query.userId : '' %>" class="input-text" min="1">
        <input type="date" name="dateFrom" value="<%= query && query.dateFrom ? query.dateFrom : '' %>" class="input-text" aria-label="From date">
        <input type="date" name="dateTo" value="<%= query && query.dateTo ? query.dateTo : '' %>" class="input-text" aria-label="To date">
        <button type="submit" class="btn btn-primary">Apply filters</button>
      </form>
    </section>

    <div class="table-scroll">
      <table class="data-table admin-data-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>User</th>
            <th>Action</th>
            <th>Details</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function(l) { %>
            <tr>
              <td><%= new Date(l.created_at).toLocaleString() %></td>
              <td><%= l.email || ('ID ' + l.user_id) %></td>
              <td><code class="audit-action-code"><%= l.action %></code></td>
              <td><%= l.details || '—' %></td>
              <td><%= l.ip_address || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="muted admin-footnote">Showing up to 500 most recent matching entries.</p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
