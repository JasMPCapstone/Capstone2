<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= company.name %> — Companies — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <header class="admin-page-head">
      <p class="admin-kicker"><a href="/admin" class="admin-crumb">System administration</a> / <a href="/admin/companies" class="admin-crumb">Company management</a></p>
      <p class="admin-page-subline">Organization detail</p>
      <p class="admin-page-lede">
        Review users and documents for this client. Set each document to <strong>waiting for approval</strong>, <strong>approved</strong>, or <strong>rejected</strong>.
        New uploads start as waiting for approval and appear in the notification count on the companies list until you change the status.
      </p>
      <p class="admin-page-actions">
        <a href="/admin/companies/<%= company.id %>/admins/new" class="btn btn-primary">Add client admin</a>
        <a href="/documents?companyId=<%= company.id %>" class="btn btn-secondary">Open in document library</a>
        <form method="post" action="/admin/companies/<%= company.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this company? All users, documents, and approvals for this organization will be permanently removed. This cannot be undone.');">
          <button type="submit" class="btn btn-secondary danger">Delete company</button>
        </form>
      </p>
    </header>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert info"><%= message %></div>
    <% } %>

    <section class="admin-detail-section" aria-labelledby="users-heading">
      <h2 id="users-heading" class="admin-section-title">Users in this organization</h2>
      <% if (users && users.length) { %>
        <div class="table-scroll">
          <table class="data-table admin-data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
                <tr>
                  <td><%= u.full_name %></td>
                  <td><%= u.email %></td>
                  <td>
                    <% if (u.role === 'SYSTEM_ADMIN' || u.role === 'ADMIN') { %>
                      <span class="role-pill role-pill-system">System admin</span>
                    <% } else if (u.role === 'CLIENT_ADMIN') { %>
                      <span class="role-pill role-pill-client-admin">Client admin</span>
                    <% } else { %>
                      <span class="role-pill role-pill-staff">Staff</span>
                    <% } %>
                  </td>
                  <td><%= u.is_active ? 'Active' : 'Deactivated' %></td>
                  <td><%= new Date(u.created_at).toLocaleDateString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">No users linked to this company yet. Add a client administrator to get started.</p>
      <% } %>
    </section>

    <section class="admin-detail-section" aria-labelledby="docs-heading">
      <h2 id="docs-heading" class="admin-section-title">Documents &amp; approval</h2>
      <% if (documents && documents.length) { %>
        <div class="table-scroll">
          <table class="data-table admin-data-table company-doc-table">
            <thead>
              <tr>
                <th>Document</th>
                <th>Uploaded by</th>
                <th>Role</th>
                <th>Uploaded</th>
                <th>Approval</th>
              </tr>
            </thead>
            <tbody>
              <% documents.forEach(function(d) { %>
                <tr>
                  <td>
                    <a href="/documents/<%= d.id %>"><%= d.title || d.original_filename || 'Untitled' %></a>
                    <span class="muted doc-meta"><%= d.file_extension ? d.file_extension.toUpperCase() : '' %> · <%= (d.file_size / 1024).toFixed(1) %> KB</span>
                  </td>
                  <td><%= d.owner_name %></td>
                  <td>
                    <% if (d.owner_role === 'CLIENT_ADMIN') { %><span class="role-pill role-pill-client-admin">Client admin</span>
                    <% } else if (d.owner_role === 'SYSTEM_ADMIN' || d.owner_role === 'ADMIN') { %><span class="role-pill role-pill-system">System admin</span>
                    <% } else { %><span class="role-pill role-pill-staff">Staff</span><% } %>
                  </td>
                  <td><%= new Date(d.created_at).toLocaleString() %></td>
                  <td>
                    <form method="post" action="/admin/companies/<%= company.id %>/documents/<%= d.id %>/approval" class="approval-form">
                      <label class="sr-only" for="status-<%= d.id %>">Approval status</label>
                      <select name="approval_status" id="status-<%= d.id %>" class="input-text approval-select">
                        <option value="PENDING" <%= d.approval_status === 'PENDING' ? 'selected' : '' %>>Waiting for approval</option>
                        <option value="APPROVED" <%= d.approval_status === 'APPROVED' ? 'selected' : '' %>>Approved</option>
                        <option value="REJECTED" <%= d.approval_status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                      </select>
                      <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">No documents uploaded for this company yet.</p>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
