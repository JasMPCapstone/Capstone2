<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content">
    <h1>Admin dashboard</h1>
    <div class="stats">
      <div class="stat-card">
        <span class="stat-value"><%= userCount %></span>
        <span class="stat-label">Users</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= docCount %></span>
        <span class="stat-label">Documents</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= logCount %></span>
        <span class="stat-label">Audit log entries</span>
      </div>
    </div>
    <p>
      <a href="/admin/users" class="btn">Manage users</a>
      <a href="/admin/audit" class="btn">View audit log</a>
      <a href="/documents" class="btn">All documents</a>
    </p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
