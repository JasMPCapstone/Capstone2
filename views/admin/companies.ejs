<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Companies — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <header class="admin-page-head admin-directory-intro">
      <p class="admin-kicker"><a href="/admin" class="admin-crumb">System administration</a> / Companies</p>
      <p class="admin-page-lede">
        Each row is a registered client company. Open the <strong>company name</strong> for users, documents, and approvals. The badge shows documents still <strong>waiting for approval</strong>.
      </p>
    </header>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert info"><%= message %></div>
    <% } %>

    <section class="admin-mgmt-panel" aria-labelledby="companies-table-title">
      <%- include('../partials/admin-directory-tabs') %>

      <div class="admin-mgmt-toolbar">
        <div class="admin-mgmt-toolbar-left">
          <h2 id="companies-table-title" class="admin-mgmt-heading">Registered companies <span class="admin-mgmt-count"><%= companies.length %></span></h2>
        </div>
        <div class="admin-mgmt-toolbar-right">
          <a href="/admin/companies/new" class="btn btn-primary btn-sm">+ Add company</a>
        </div>
      </div>

      <div class="table-scroll admin-mgmt-table-scroll">
        <table class="data-table admin-data-table admin-mgmt-table">
          <thead>
            <tr>
              <th scope="col">Company</th>
              <th scope="col">Users</th>
              <th scope="col">Documents</th>
              <th scope="col">Created</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% companies.forEach(function(c) { %>
            <tr>
              <td data-label="Company">
                <div class="admin-user-cell">
                  <span class="admin-user-avatar admin-user-avatar--company" aria-hidden="true"><%= (c.name && c.name.charAt(0)) ? c.name.charAt(0).toUpperCase() : 'C' %></span>
                  <div class="admin-user-cell-text">
                    <a href="/admin/companies/<%= c.id %>" class="company-name-link">
                      <strong><%= c.name %></strong>
                      <% var _p = typeof c.pending_doc_count !== 'undefined' ? Number(c.pending_doc_count) : 0; if (_p > 0) { %>
                        <span class="notification-badge" title="<%= _p %> document(s) waiting for approval" aria-label="<%= _p %> documents waiting for approval"><%= _p %></span>
                      <% } %>
                    </a>
                  </div>
                </div>
              </td>
              <td data-label="Users"><%= c.user_count %></td>
              <td data-label="Documents"><%= typeof c.doc_count !== 'undefined' ? c.doc_count : 0 %></td>
              <td data-label="Created"><%= new Date(c.created_at).toLocaleDateString() %></td>
              <td data-label="Actions" class="admin-actions-cell">
                <div class="admin-action-row">
                  <a href="/documents?companyId=<%= c.id %>" class="admin-action-link">View documents</a>
                  <a href="/admin/companies/<%= c.id %>/admins/new" class="admin-action-link">Add client admin</a>
                  <form method="post" action="/admin/companies/<%= c.id %>/delete" class="admin-inline-form" onsubmit="return confirm('Are you sure you want to delete this company? All users, documents, and approvals for this organization will be permanently removed. This cannot be undone.');">
                    <button type="submit" class="admin-action-link admin-action-link--danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (!companies.length) { %>
        <p class="muted admin-empty-hint admin-mgmt-empty">No companies yet. Use <strong>+ Add company</strong> after onboarding is approved.</p>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
