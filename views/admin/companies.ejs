<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Organizations — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert info"><%= message %></div>
    <% } %>

    <section class="admin-mgmt-panel" aria-labelledby="companies-table-title">
      <%- include('../partials/admin-directory-tabs') %>

      <div class="admin-mgmt-toolbar">
        <div class="admin-mgmt-toolbar-left">
          <h2 id="companies-table-title" class="admin-mgmt-heading">Registered organizations <span class="admin-mgmt-count"><%= companies.length %></span></h2>
        </div>
        <div class="admin-mgmt-toolbar-right">
          <a href="/admin/companies/new" class="btn btn-primary btn-sm">+ Add organization</a>
        </div>
      </div>

      <div class="table-scroll admin-mgmt-table-scroll">
        <table class="data-table admin-data-table admin-mgmt-table">
          <thead>
            <tr>
              <th scope="col">Organization</th>
              <th scope="col">Users</th>
              <th scope="col">Documents</th>
              <th scope="col">Created</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% companies.forEach(function(c) { %>
            <tr>
              <td data-label="Organization">
                <div class="admin-user-cell">
                  <span class="admin-user-avatar admin-user-avatar--company" aria-hidden="true"><%= (c.name && c.name.charAt(0)) ? c.name.charAt(0).toUpperCase() : 'C' %></span>
                  <div class="admin-user-cell-text">
                    <a href="/admin/companies/<%= c.id %>" class="company-name-link">
                      <strong><%= c.name %></strong>
                      <% var _p = typeof c.pending_doc_count !== 'undefined' ? Number(c.pending_doc_count) : 0; if (_p > 0) { %>
                        <span class="notification-badge" title="<%= _p %> document(s) waiting for approval" aria-label="<%= _p %> documents waiting for approval"><%= _p %></span>
                      <% } %>
                    </a>
                  </div>
                </div>
              </td>
              <td data-label="Users"><%= c.user_count %></td>
              <td data-label="Documents"><%= typeof c.doc_count !== 'undefined' ? c.doc_count : 0 %></td>
              <td data-label="Created"><%= new Date(c.created_at).toLocaleDateString() %></td>
              <td data-label="Actions" class="admin-actions-cell">
                <div class="admin-action-row admin-action-row--icons" role="group" aria-label="Organization actions">
                  <a href="/documents?companyId=<%= c.id %>" class="admin-action-link admin-action-link--icon-only" title="View documents in library" aria-label="View documents in library">
                    <svg class="admin-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </a>
                  <a href="/admin/companies/<%= c.id %>/admins/new" class="admin-action-link admin-action-link--icon-only" title="Add manager" aria-label="Add manager">
                    <svg class="admin-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                  </a>
                  <form method="post" action="/admin/companies/<%= c.id %>/delete" class="admin-inline-form" onsubmit="return confirm('Are you sure you want to delete this organization? All users, documents, and approvals will be permanently removed. This cannot be undone.');">
                    <button type="submit" class="admin-action-link admin-action-link--danger admin-action-link--icon-only" title="Delete organization" aria-label="Delete organization">
                      <svg class="admin-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (!companies.length) { %>
        <p class="muted admin-empty-hint admin-mgmt-empty">No organizations yet. Use <strong>+ Add organization</strong> after onboarding is approved.</p>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
