<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add user — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <header class="admin-page-head admin-directory-intro">
      <p class="admin-kicker"><a href="/admin" class="admin-crumb">System administration</a> / <a href="/admin/users" class="admin-crumb">Users</a> / Add user</p>
      <h1 class="admin-page-title">Add a new user</h1>
      <p class="admin-page-lede">
        Creates a <strong>client administrator</strong> or <strong>client user</strong> under a registered company.
        Share the temporary password securely; they must change it after signing in.
      </p>
    </header>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert error"><%= message %></div>
    <% } %>

    <% if (!companies || !companies.length) { %>
      <p class="muted">No companies yet. <a href="/admin/companies/new">Add a company</a> before adding users.</p>
    <% } else { %>
    <section class="settings-card admin-form-card">
      <h2 class="admin-card-title">Account details</h2>
      <form method="post" action="/admin/users" class="settings-form">
        <label for="companyId">Company</label>
        <select id="companyId" name="companyId" required class="input-text">
          <option value="" disabled <% if (!preselectCompanyId) { %>selected<% } %>>Select company</option>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= preselectCompanyId === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>

        <label for="role">Role</label>
        <select id="role" name="role" required class="input-text">
          <option value="CLIENT">Client user (staff)</option>
          <option value="CLIENT_ADMIN">Client administrator</option>
        </select>
        <p class="muted form-hint">Client admins can manage their company’s team and documents; staff upload and view per your process.</p>

        <label for="fullName">Full name</label>
        <input type="text" id="fullName" name="fullName" required class="input-text" autocomplete="name">

        <label for="email">Work email</label>
        <input type="email" id="email" name="email" required class="input-text" autocomplete="off">

        <label for="tempPassword">Temporary password</label>
        <input type="text" id="tempPassword" name="tempPassword" required minlength="6" class="input-text" autocomplete="new-password" aria-describedby="pw-hint-new">
        <p id="pw-hint-new" class="muted form-hint">Minimum 6 characters. User must change this after signing in.</p>

        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary">Create user</button>
          <a href="/admin/users" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </section>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
