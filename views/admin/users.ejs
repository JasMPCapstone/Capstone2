<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users — System administration — MedSupply Portal</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container main-content admin-main">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert info"><%= message %></div>
    <% } %>

    <section class="admin-mgmt-panel" aria-labelledby="users-table-title">
      <%- include('../partials/admin-directory-tabs') %>

      <div class="admin-mgmt-toolbar admin-mgmt-toolbar--users">
        <div class="admin-mgmt-toolbar-left">
          <h2 id="users-table-title" class="admin-mgmt-heading">All users <span class="admin-mgmt-count"><%= typeof usersTotalCount !== 'undefined' ? usersTotalCount : users.length %></span></h2>
        </div>
        <div class="admin-mgmt-toolbar-right admin-mgmt-toolbar-actions">
          <form method="get" action="/admin/users" class="admin-users-filter-form" aria-label="Filter users by organization">
            <select name="companyId" id="filter-company" class="filter-select admin-users-filter-select" aria-label="Filter by organization" onchange="this.form.submit()">
              <option value="" <%= (typeof selectedCompanyId === 'undefined' || selectedCompanyId === null) ? 'selected' : '' %>>All organizations</option>
              <% if (typeof companies !== 'undefined' && companies) { companies.forEach(function(c) { %>
                <option value="<%= c.id %>" <%= selectedCompanyId === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }); } %>
            </select>
          </form>
        </div>
      </div>

      <div class="table-scroll admin-mgmt-table-scroll">
        <table class="data-table admin-data-table admin-mgmt-table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Role</th>
              <th scope="col">Organization</th>
              <th scope="col">Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) {
              var _name = (u.full_name && String(u.full_name).trim()) ? u.full_name : u.email;
              var _initial = (_name.replace(/^[^a-zA-Z0-9]+/, '').charAt(0) || '?').toUpperCase();
            %>
            <tr>
              <td>
                <div class="admin-user-cell">
                  <span class="admin-user-avatar" aria-hidden="true"><%= _initial %></span>
                  <div class="admin-user-cell-text">
                    <span class="admin-user-name"><%= _name %></span>
                    <span class="admin-user-email"><%= u.email %></span>
                  </div>
                </div>
              </td>
              <td>
                <% if (u.role === 'SYSTEM_ADMIN' || u.role === 'ADMIN') { %>
                  <span class="role-pill role-pill-system">System admin</span>
                <% } else if (u.role === 'CLIENT_ADMIN') { %>
                  <span class="role-pill role-pill-client-admin">Manager</span>
                <% } else { %>
                  <span class="role-pill role-pill-staff">Staff</span>
                <% } %>
              </td>
              <td class="col-company"><%= u.company_name || '—' %></td>
              <td class="admin-status-cell">
                <% if (u.is_active && u.id === user.userId) { %>
                  <span class="admin-status admin-status--readonly" title="Your account"><span class="admin-status-dot admin-status-dot--active" aria-hidden="true"></span> Active</span>
                <% } else if (u.is_active) { %>
                  <form action="/admin/users/<%= u.id %>/deactivate" method="post" class="admin-status-form">
                    <button type="submit" class="admin-status-toggle admin-status-toggle--active" title="Click to deactivate (suspend access)">
                      <span class="admin-status-dot admin-status-dot--active" aria-hidden="true"></span> Active
                    </button>
                  </form>
                <% } else { %>
                  <form action="/admin/users/<%= u.id %>/reactivate" method="post" class="admin-status-form">
                    <button type="submit" class="admin-status-toggle admin-status-toggle--inactive" title="Click to activate">
                      <span class="admin-status-dot admin-status-dot--inactive" aria-hidden="true"></span> Inactive
                    </button>
                  </form>
                <% } %>
              </td>
              <td class="admin-actions-cell">
                <div class="admin-action-row">
                  <a href="/admin/users/<%= u.id %>/reset-password" class="admin-action-link admin-action-link--icon-only" title="Reset password" aria-label="Reset password">
                    <svg class="admin-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                  </a>
                  <% if (u.id !== user.userId) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="post" class="admin-inline-form" onsubmit="return confirm('Permanently delete this user and all of their uploaded documents? This cannot be undone.');">
                      <button type="submit" class="admin-action-link admin-action-link--danger admin-action-link--icon-only" title="Delete user" aria-label="Delete">
                        <svg class="admin-action-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (typeof usersTotalPages !== 'undefined' && usersTotalPages > 1) { %>
      <nav class="admin-table-pagination" aria-label="User list pages">
        <% if (usersListPrev) { %>
          <a href="<%= usersListPrev %>" class="admin-table-pagination-link">Previous</a>
        <% } else { %>
          <span class="admin-table-pagination-link is-disabled" aria-disabled="true">Previous</span>
        <% } %>
        <span class="admin-table-pagination-status">Page <%= usersPage %> of <%= usersTotalPages %></span>
        <% if (usersListNext) { %>
          <a href="<%= usersListNext %>" class="admin-table-pagination-link">Next</a>
        <% } else { %>
          <span class="admin-table-pagination-link is-disabled" aria-disabled="true">Next</span>
        <% } %>
      </nav>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
