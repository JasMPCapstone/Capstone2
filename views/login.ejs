<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page login-split">
  <div class="login-split-inner">
    <aside class="login-sidebar" aria-label="MedSupply Innovations">
      <div class="login-sidebar-top">
        <h1 class="login-sidebar-brand">MEDSUPPLY INNOVATIONS</h1>
        <p class="login-sidebar-lede">Your Australian trusted medical consumables &amp; equipment supplier. Sourcing, manufacturing and supply of all consumables and medical devices.</p>
      </div>
      <ul class="login-sidebar-links">
        <li><a href="#">Client Onboarding Questionnaire Portal</a></li>
        <li><a href="#">Med Supply Portal</a></li>
        <li><a href="#">Certified</a></li>
      </ul>
    </aside>
    <div class="login-main">
      <div class="login-wrap">
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert <%= typeof alertType !== 'undefined' && alertType === 'error' ? 'error' : 'info' %>"><%= message %></div>
        <% } %>
        <div class="auth-card auth-card--split">
          <div class="auth-logo">
            <span class="logo-circle"><span class="logo-cross"></span></span>
            <span class="logo-label">MEDSUPPLY</span>
          </div>
          <p class="auth-subtitle">Secure Document Portal</p>
          <form method="post" action="/login" class="auth-form">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Enter your email" required autocomplete="email">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
            <button type="submit" class="btn btn-signin">Sign In</button>
          </form>
          <p class="form-footer form-footer-forgot"><a href="/forgot-password">Forgot password?</a></p>
          <p class="login-footnote muted">Accounts are created by your organization. Contact your administrator if you need access.</p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
