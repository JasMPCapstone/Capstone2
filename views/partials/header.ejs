<% if (typeof isSystemAdmin !== 'undefined' && isSystemAdmin) { %>
<%
  var _adminTitle = typeof adminPageTitle !== 'undefined' && adminPageTitle ? adminPageTitle : '';
  if (!_adminTitle && typeof adminNav !== 'undefined') {
    if (adminNav === 'overview') _adminTitle = 'Dashboard';
    else if (adminNav === 'directory') _adminTitle = typeof adminPageTitle !== 'undefined' && adminPageTitle ? adminPageTitle : 'User management';
    else if (adminNav === 'users') _adminTitle = 'Users';
    else if (adminNav === 'companies') _adminTitle = 'Organizations';
    else if (adminNav === 'audit') _adminTitle = 'Audit log';
  }
  if (!_adminTitle && typeof navActive !== 'undefined') {
    if (navActive === 'documents') _adminTitle = 'Documents';
    if (navActive === 'help') _adminTitle = 'Help';
    if (navActive === 'upload') _adminTitle = 'Upload document';
    if (navActive === 'settings') _adminTitle = 'Two-factor authentication';
  }
  if (!_adminTitle) _adminTitle = 'Dashboard';
  var _docNav = (typeof navActive !== 'undefined' && (navActive === 'documents' || navActive === 'upload'));
  var _notifyPending = typeof adminNotifyPending !== 'undefined' ? Number(adminNotifyPending) : 0;
  var _notifyOnboarding = typeof adminNotifyOnboarding !== 'undefined' ? Number(adminNotifyOnboarding) : 0;
  var _notifyTotal = typeof adminNotifyBadgeTotal !== 'undefined' ? Number(adminNotifyBadgeTotal) : _notifyPending + _notifyOnboarding;
  var _notifyRawTotal = _notifyPending + _notifyOnboarding;
  var _notifySuppressed = typeof adminNotifySuppressed !== 'undefined' && adminNotifySuppressed;
%>
<div class="admin-app">
  <aside class="admin-sidebar" aria-label="Main navigation">
    <a href="/admin" class="admin-sidebar-brand">
      <span class="admin-sidebar-logo" aria-hidden="true"></span>
      <span class="admin-sidebar-brand-text">Med Supply Innovation</span>
    </a>
    <nav class="admin-sidebar-nav">
      <a href="/admin" class="admin-sidebar-link <%= typeof adminNav !== 'undefined' && adminNav === 'overview' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/admin/users" class="admin-sidebar-link <%= typeof adminNav !== 'undefined' && (adminNav === 'directory' || adminNav === 'users') ? 'is-active' : '' %>">User management</a>
      <a href="/documents" class="admin-sidebar-link <%= _docNav ? 'is-active' : '' %>">Documents</a>
      <a href="/help" class="admin-sidebar-link <%= typeof navActive !== 'undefined' && navActive === 'help' ? 'is-active' : '' %>">Help</a>
    </nav>
    <div class="admin-sidebar-meta">
      <a href="/settings/2fa" class="admin-sidebar-meta-link">Account security (2FA)</a>
    </div>
  </aside>
  <div class="admin-stage">
    <header class="admin-topbar">
      <div class="admin-topbar-inner">
        <h1 class="admin-topbar-title"><%= _adminTitle %></h1>
        <div class="admin-topbar-actions">
          <details class="admin-notify">
            <summary class="admin-notify-trigger" aria-label="Notifications">
              <span class="admin-notify-bell" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              </span>
              <% if (_notifyTotal > 0) { %>
                <span class="admin-notify-count"><%= _notifyTotal > 99 ? '99+' : _notifyTotal %></span>
              <% } %>
            </summary>
            <div class="admin-notify-panel">
              <% var _feed = typeof adminNotifyFeed !== 'undefined' && Array.isArray(adminNotifyFeed) ? adminNotifyFeed : []; %>
              <% if (_notifySuppressed && _notifyRawTotal > 0) { %>
                <p class="admin-notify-cleared">Notifications cleared. The badge will return when there is something new to review.</p>
              <% } else if (!_feed.length) { %>
                <p class="admin-notify-empty">No notifications.</p>
              <% } else { %>
                <p class="admin-notify-panel-title">Notifications</p>
                <% _feed.forEach(function(n) { %>
                  <a href="<%= n.href %>" class="admin-notify-item">
                    <span class="admin-notify-item-title"><%= n.title %></span>
                    <span class="admin-notify-item-meta"><%= n.meta %></span>
                  </a>
                <% }); %>
                <form method="post" action="/admin/notifications/clear" class="admin-notify-clear-form">
                  <button type="submit" class="admin-notify-clear-btn">Clear notifications</button>
                </form>
              <% } %>
            </div>
          </details>
          <form action="/logout" method="post" class="admin-topbar-logout">
            <button type="submit" class="admin-topbar-logout-btn">Logout</button>
          </form>
        </div>
      </div>
    </header>
    <div class="admin-content">
<% } else { %>
<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <span class="logo-icon" aria-hidden="true"></span>
      <span class="brand-text">Med Supply Innovation</span>
    </a>
    <nav class="nav-main">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (typeof isClientAdmin !== 'undefined' && isClientAdmin) { %>
          <a href="/company/team" class="nav-item <%= typeof navActive !== 'undefined' && navActive === 'team' ? 'active' : '' %>">Team</a>
        <% } %>
        <a href="/dashboard" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'dashboard' ? 'active' : '') %>">Dashboard</a>
        <a href="/documents/upload" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'upload' ? 'active' : '') %>">Upload Document</a>
        <a href="/documents" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'documents' ? 'active' : '') %>">My Documents</a>
        <a href="/help" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'help' ? 'active' : '') %>">Help</a>
        <form action="/logout" method="post" class="nav-logout">
          <button type="submit" class="btn-link nav-logout-btn" title="Logout">
          <svg class="icon-logout-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-item">Login</a>
      <% } %>
    </nav>
  </div>
</header>
<% } %>
