<header class="site-header">
  <div class="container">
    <a href="/" class="brand">
      <span class="logo-icon" aria-hidden="true"></span>
      <span class="brand-text">Med Supply Innovation</span>
    </a>
    <nav class="nav-main">
      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'ADMIN') { %>
          <a href="/admin" class="nav-item">Admin</a>
          <a href="/admin/users" class="nav-item">Users</a>
          <a href="/admin/audit" class="nav-item">Audit Log</a>
        <% } %>
        <a href="/dashboard" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'dashboard' ? 'active' : '') %>">Dashboard</a>
        <a href="/documents/upload" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'upload' ? 'active' : '') %>">Upload</a>
        <a href="/documents" class="nav-item <%= typeof navActive === 'undefined' ? '' : (navActive === 'documents' ? 'active' : '') %>">My Documents</a>
        <form action="/logout" method="post" class="nav-logout">
          <button type="submit" class="btn-link nav-logout-btn" title="Logout">
          <svg class="icon-logout-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-item">Login</a>
        <a href="/register" class="nav-item">Register</a>
      <% } %>
    </nav>
  </div>
</header>
