<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up — Med Supply Innovation</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="login-wrap">
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert <%= typeof alertType !== 'undefined' && alertType === 'error' ? 'error' : 'info' %>"><%= message %></div>
    <% } %>
    <div class="auth-card">
      <div class="auth-logo">
        <span class="logo-circle"><span class="logo-cross"></span></span>
        <span class="logo-label">MEDSUPPLY</span>
      </div>
      <h1 class="auth-title">Med Supply Innovation</h1>
      <p class="auth-subtitle">Secure Document Portal</p>
      <form method="post" action="/register" class="auth-form">
        <label for="fullName">Full name</label>
        <input type="text" id="fullName" name="fullName" placeholder="Enter your full name" required autocomplete="name">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required autocomplete="email">
        <label for="password">Password (min 6 characters)</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required minlength="6" autocomplete="new-password">
        <button type="submit" class="btn btn-signin">Sign Up</button>
      </form>
      <p class="form-footer">Already have an account? <a href="/login">Sign In</a></p>
    </div>
  </div>
</body>
</html>
