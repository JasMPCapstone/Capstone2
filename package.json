{
  "name": "medsupply-portal",
  "version": "1.0.0",
  "description": "Secure Document Upload & Management Portal - MedSupply Innovations",
  "main": "server.js",
  "scripts": {
    "prestart": "npm run build:client",
    "start": "node server.js",
    "dev": "node server.js",
    "dev:full": "concurrently -n api,vite -c blue,magenta \"npm run dev\" \"npm run client:dev\"",
    "test": "node tests/run-tests.js",
    "setup-db": "node scripts/setup-db.js",
    "build:client": "npm run build --prefix client",
    "client:dev": "npm run dev --prefix client",
    "migrate-uploads-s3": "node scripts/migrate-uploads-to-s3.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "document",
    "upload",
    "portal",
    "medsupply"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
